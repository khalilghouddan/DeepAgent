MODEL_PROVIDER=local
CHAT_MODEL=qwen3.5:latest
BASE_URL=http://your-model-server/ollama-v2/api/v1
API_KEY=your_local_provider_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=
MAX_CONCURRENT_RESEARCH_UNITS=3
MAX_RESEARCHER_ITERATIONS=3
AGENT_TIMEOUT_SECONDS=0
LOG_LEVEL=INFO
SEARXNG_URL=http://searxng:8080/search
SEARXNG_LANGUAGE=any
SEARXNG_MAX_RESULTS=3
CRAWL4AI_URL=http://crawl4ai:8001
CRAWL4AI_SCRAPE_PATH=/scrape
CRAWL4AI_TIMEOUT=30
CRAWL4AI_API_TOKEN=
DEEP_AGENT_DB_ENABLED=true
DEEP_AGENT_DB_HOST=host.docker.internal
DEEP_AGENT_DB_PORT=5433
DEEP_AGENT_DB_USER=postgres
DEEP_AGENT_DB_PASSWORD=your_postgres_password_here
DEEP_AGENT_DB_NAME=deep_search_results
